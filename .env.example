# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server & Security
PORT=3000
JWT_SECRET="grine-restaurant-pos-super-secure-key"

# Database Configuration (PostgreSQL)
SQL_HOST="127.0.0.1"
SQL_PORT=5432
SQL_USER="postgres"
SQL_PASSWORD="password"
SQL_DB_NAME="grine_pos"

# Windows 7 Node.js Compatibility (Set this in Windows environment variables):
# NODE_SKIP_PLATFORM_CHECK=1

# Windows Thermal Printer Setup
DEFAULT_PRINTER_NAME="CAFETERIA"
DEFAULT_PRINTER_DRIVER="80Normal"
